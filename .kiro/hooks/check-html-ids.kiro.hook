{
  "enabled": true,
  "name": "HTML ID Integrity",
  "description": "Checks that critical HTML element IDs referenced by app.js exist in index.html",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "node -e \"const h=require('fs').readFileSync('index.html','utf8'); const ids=['card1','card2','card3','card4','map','tailscaleKey','providerApiKey','downloadBtn','nextToCard2','nextToCard3','nextToCard4','selectionSummary','billingPanel','billingAcks','billingNextActions','instructionsPreview']; const missing=ids.filter(id=>!h.includes('id=\\\"'+id+'\\\"')); if(missing.length){console.log('❌ Missing IDs:',missing.join(', '));process.exit(1)}else{console.log('✅ All critical HTML IDs present')}\""
  }
}